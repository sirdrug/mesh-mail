# --- Секреты: главное, что не должно уехать в репозиторий -------------------
.env
.env.*
config/node.yaml
config/bridge.yaml
!config/node.example.yaml
*.pem
*.key

# Приватные NKey seed'ы узлов (файлы SU...). Утечка любого из них =
# возможность выдать себя за этот узел. Публичные ключи (U...) не секретны
# и живут прямо в nats/hub.conf.
secrets/
*.nk
*.creds

# --- Go ---------------------------------------------------------------------
# собранные бинарники mesh
bin/
# профили и покрытие
*.out
*.test

# --- Локальные артефакты ----------------------------------------------------
# Комментарии только на отдельной строке: git не поддерживает их в конце
# строки с шаблоном и считает всю строку, вместе с пробелами и решёткой,
# частью самого шаблона.
/*.png
/*.jpg
/*.jpeg
/Screenshot*
*.log
logs/
state/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
jetstream/
nats-data/

# --- ОС и редакторы ---------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# Исходники аватарок в полном разрешении: 41 МБ, из которых в дело идут
# 512 пикселей — больше Telegram всё равно не показывает. В репозитории
# лежат ужатые копии (assets/avatars/), а оригиналы остаются на машине,
# где их сделали: клон тянется на четыре машины, включая Pi.
assets/avatars-original/

# Чужие проекты, положенные внутрь каталога для удобства. В публичный
# репозиторий они уехать не должны — в том числе случайным `git add .`.
other-projects/
