# Будильник Codex-сессии: на входящее письмо тычок в мультиплексор.
#
# ПОЛЬЗОВАТЕЛЬСКИЙ юнит, а не системный, и это принципиально. Сокет
# мультиплексора принадлежит конкретному пользователю: у tmux он лежит в
# /run/user/<uid>, у screen — в /run/screen/S-<пользователь>. Системный
# сервис от root чужой сокет не увидит и промахнётся молча.
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/systemd/mesh-daemon.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now mesh-daemon
#
# Чтобы демон работал без открытой SSH-сессии, пользователю нужен linger,
# иначе systemd погасит его пользовательский менеджер при выходе:
#
#   sudo loginctl enable-linger $USER
#
# КУДА ТЫКАТЬ, задаётся в конфиге узла полем wake_target, и способ пишется
# явно:
#
#   wake_target: "screen:codex"        # сессия screen по имени
#   wake_target: "tmux:pi-codex"       # сессия tmux по имени
#
# Автоопределения по наличию сокета нет намеренно: оно ведёт себя по-разному
# на разных машинах и однажды промолчит. На Pi, например, агенты живут в
# screen, и демон, знающий только tmux, не разбудил бы никого.
#
# Имя сессии tmux — БЕЗ индекса окна (`pi-codex`, а не `pi-codex:0`). При
# `base-index 1` в ~/.tmux.conf окна «0» не существует, и тычок уйдёт в
# никуда. Имя сессии разрешается в её активное окно и от индексации не
# зависит.
#
# Демон проверяет цель на старте и не запускается, если такой сессии нет.
#
# Целевая панель должна быть запущенным Codex, а не обычным shell: демон
# ПЕЧАТАЕТ в неё, и shell попытался бы выполнить присланное как команду.
#
# ПУТИ НИЖЕ — под установку из клона репозитория, как в docs/deployment.md.
# Если бинарник и конфиг лежат иначе (на Pi, где нет Go, это
# ~/.local/bin/mesh и ~/.mesh/<узел>.yaml), поправьте ExecStart.
#
# Логи: journalctl --user -u mesh-daemon -f. Если пользовательский journal
# не настроен и записей не видно, последние строки покажет
# systemctl --user status mesh-daemon.

[Unit]
Description=mesh-mail: будильник Codex-сессии
Documentation=https://github.com/boreevyuri/mesh-mail
# After=default.target здесь не нужен и вреден: юнит ставится через
# WantedBy=default.target, а target упорядочивается ПОСЛЕ своих wanted units.
# Явный After замкнул бы порядок в цикл, который systemd пришлось бы рвать.

[Service]
Type=simple

# Путь к приватному NKey узла. Нужен, только если в конфиге он подставляется
# из окружения (${MESH_NKEY_FILE}); при абсолютном пути в конфиге эта строка
# не требуется. Файл должен быть 600 и лежать вне репозитория.
Environment=MESH_NKEY_FILE=%h/.mesh/node.nk
ExecStart=%h/mesh-mail/bin/mesh daemon --config %h/mesh-mail/config/node.yaml

# Промах тычка ничего не теряет: письмо остаётся в ящике, и агент увидит его
# при следующем fetch_inbox. Поэтому перезапуск безусловный — отсутствие
# сессии мультиплексора не повод считать демона сломанным.
Restart=always
RestartSec=5

NoNewPrivileges=true

[Install]
WantedBy=default.target
